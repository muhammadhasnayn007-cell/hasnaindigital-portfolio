{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Represents an authenticated client/visitor user profile.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "format": "email", "maxLength": 254 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastLoginAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email", "createdAt"]
    },
    "ProjectInquiry": {
      "title": "Project Inquiry",
      "description": "Stores persistent inquiries submitted by authenticated users or clients.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "format": "email", "maxLength": 254 },
        "subject": { "type": "string", "maxLength": 200 },
        "service": { "type": "string", "maxLength": 100 },
        "message": { "type": "string", "maxLength": 2000 },
        "status": { "type": "string", "enum": ["new", "reviewing", "contacted", "closed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "name", "email", "subject", "message", "createdAt"]
    },
    "ChatSession": {
      "title": "Chat Consultation Session",
      "description": "Stores persistent consultation conversation history with Hasnain's Assistant.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "leadStatus": { "type": "string", "maxLength": 50 },
        "lastMessage": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles indexed by UID"
    },
    "/users/{userId}/inquiries/{inquiryId}": {
      "schema": "ProjectInquiry",
      "description": "Client project inquiries belonging to user"
    },
    "/users/{userId}/chat_sessions/{sessionId}": {
      "schema": "ChatSession",
      "description": "Saved assistant chat sessions belonging to user"
    }
  }
}
