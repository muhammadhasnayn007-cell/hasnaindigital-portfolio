# ==============================================================================
# HASNAIN DIGITAL MARKETER - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to `.env` for local development:
#   cp .env.example .env
#
# For production hosting (Render, Railway, Vercel, Netlify, VPS), configure these
# environment variables in your deployment dashboard.
# NEVER commit your real `.env` file containing secrets to GitHub.
# ==============================================================================

# Server Environment
PORT=3000
NODE_ENV=production

# 1. Target Notification Email
# All visitor contact messages and private AI lead alerts are delivered here:
CONTACT_EMAIL=muhammadhasnayn007@gmail.com

# 2. Production Website URL (Used for canonical metadata & email logo references)
SITE_URL=https://hasnaindigitalmarketer.com

# 3. Real-Time Availability Status
# Options: "Available for Projects", "Available", "Away", "Currently Unavailable"
AVAILABILITY_STATUS="Available for Projects"

# 4. CORS Allowed Origins (Comma-separated URLs, or * for open access)
ALLOWED_ORIGINS=https://hasnaindigitalmarketer.com

# ==============================================================================
# EMAIL DELIVERY CONFIGURATION (Configure Option A OR Option B)
# ==============================================================================

# OPTION A: RESEND API (Recommended - Fast, reliable, 100 emails/day free)
# Obtain your API key at: https://resend.com
RESEND_API_KEY=
# The verified "From" sender address in Resend:
RESEND_FROM=Hasnain Digital Marketer <onboarding@resend.dev>

# OPTION B: STANDARD SMTP (Alternative - Gmail App Password, Hostinger, Namecheap)
# Generate a Gmail App Password at: https://myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password

# ==============================================================================
# AI ASSISTANT CONFIGURATION ("Hasnain's Assistant")
# ==============================================================================
# Configure EITHER Google Gemini OR OpenAI.
# If no key is set, the assistant automatically runs via its built-in semantic engine,
# ensuring zero downtime and fully offline/local operation.

# Google Gemini (Free tier available at https://aistudio.google.com)
GEMINI_API_KEY=

# OR OpenAI (https://platform.openai.com)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# ==============================================================================
# SECURITY & RATE LIMITING
# ==============================================================================
RATE_LIMIT_CONTACT=5
RATE_LIMIT_CHAT=20
