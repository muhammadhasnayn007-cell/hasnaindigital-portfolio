# ==============================================================================
# H.X.S.N DIGITAL MARKETER — ENVIRONMENT VARIABLES
# Add these to your Vercel Project Settings (Settings -> Environment Variables)
# or local .env file.
# ==============================================================================

# --- Website & General Configuration ---
SITE_URL=https://hasnaindigitalmarketer.com
CONTACT_EMAIL=muhammadhasnayn007@gmail.com
AVAILABILITY_STATUS=Available for Projects
ALLOWED_ORIGINS=*
PORT=3000

# --- AI Assistant (Hasnain's Assistant) ---
# Get your Gemini API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- Email Delivery: Option 1 (Recommended: Resend) ---
# Sign up free at https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM=H.X.S.N Digital Marketer <onboarding@resend.dev>

# --- Email Delivery: Option 2 (Alternative: Gmail SMTP) ---
# If using Gmail SMTP instead of Resend:
# 1. Enable 2-Step Verification in Google Account
# 2. Generate an "App Password" (16 letters): https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=muhammadhasnayn007@gmail.com
SMTP_PASS=

# --- Rate Limiting (Optional) ---
RATE_LIMIT_CONTACT=5
RATE_LIMIT_CHAT=25

