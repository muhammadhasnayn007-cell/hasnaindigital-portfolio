rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.id == request.auth.uid
        && data.email is string && data.email.size() <= 254
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1000));
    }

    function isValidProjectInquiry(data, userId) {
      return data.id is string
        && data.userId == userId
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 100
        && data.email is string && data.email.size() <= 254
        && data.subject is string && data.subject.size() >= 3 && data.subject.size() <= 200
        && data.message is string && data.message.size() >= 10 && data.message.size() <= 2000;
    }

    function isValidChatSession(data, userId) {
      return data.id is string
        && data.userId == userId
        && (!('leadStatus' in data) || (data.leadStatus is string && data.leadStatus.size() <= 100))
        && (!('lastMessage' in data) || (data.lastMessage is string && data.lastMessage.size() <= 2000));
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming())
        && incoming().id == existing().id
        && (!('createdAt' in existing()) || incoming().createdAt == existing().createdAt);
      allow delete: if false;

      // Inquiries subcollection
      match /inquiries/{inquiryId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(inquiryId) && isValidProjectInquiry(incoming(), userId);
        allow delete: if false;
      }

      // Chat Sessions subcollection
      match /chat_sessions/{sessionId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(sessionId) && isValidChatSession(incoming(), userId);
        allow delete: if isOwner(userId);
      }
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
