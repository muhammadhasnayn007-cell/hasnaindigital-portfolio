{
  "version": 2,
  "installCommand": "env -u npm_config_cache_dir -u NPM_CONFIG_CACHE_DIR npm install",
  "buildCommand": "env -u npm_config_cache_dir -u NPM_CONFIG_CACHE_DIR npm run build",
  "functions": {
    "server.js": {
      "includeFiles": "{index.html,admin.html,style.css,script.js,analytics-client.js,robots.txt,sitemap.xml,images/**,fonts/**,digital-marketing/**,python-development/**,seo-services/**,ui-ux-design/**,web-development/**}"
    }
  },
  "routes": [
    {
      "src": "/firebase-client.mjs",
      "dest": "/firebase-client.mjs",
      "check": true
    },
    {
      "src": "/social-icons/(.*)",
      "dest": "/social-icons/$1",
      "check": true
    },
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ],
  "headers": [
    {
      "source": "/style.css",
      "headers": [
        { "key": "Content-Type", "value": "text/css; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/script.js",
      "headers": [
        { "key": "Content-Type", "value": "application/javascript; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/analytics-client.js",
      "headers": [
        { "key": "Content-Type", "value": "application/javascript; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
